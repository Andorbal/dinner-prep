{
  "name": "dinner-prep",
  "private": true,
  "type": "module",
  "description": "Family dinner planning: recipe library, weekly plans, prep schedules and grocery lists.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "check": "node tools/plan.js check",
    "plan": "node tools/plan.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/dm-mono": "5.3.0"
  }
}
