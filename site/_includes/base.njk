<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or 'Our family dinner plan: this week, next week, recipes and grocery lists.' }}">
<link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ffd23a'/%3E%3Ccircle cx='13' cy='16' r='9' fill='%23ff4fa3'/%3E%3Ccircle cx='19' cy='16' r='9' fill='%2300a6a6' style='mix-blend-mode:multiply'/%3E%3C/svg%3E">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;var z=parseFloat(localStorage.getItem('textScale'));if(z)document.documentElement.style.setProperty('--scale',z)}catch(e){}</script>
{% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<div class="wrap">
<header class="top">
  <a class="mast" href="/" aria-label="Dinner Prep home">
    <span class="word" data-text="Dinner Prep">Dinner <b>Prep</b></span>
    <svg viewBox="0 0 56 40" aria-hidden="true"><path d="M2 30 q6-10 12 0 t12 0 t12 0" fill="none" stroke="var(--teal)" stroke-width="3.5" stroke-linecap="round"/><path d="M40 4 l12 20 h-24z" fill="var(--yellow)" style="mix-blend-mode:var(--blend)"/><circle cx="38" cy="32" r="2.4" fill="var(--pink)"/><circle cx="46" cy="32" r="2.4" fill="var(--pink)"/><circle cx="54" cy="32" r="2.4" fill="var(--pink)"/></svg>
  </a>
  <nav class="main" aria-label="Main">
    {% set nav = [["/", "This week"], ["/recipes/", "Recipes"], ["/prep/", "Prep"], ["/grocery/", "Grocery list"], ["/history/", "History"]] %}
    {% for item in nav %}<a href="{{ item[0] }}"{% if section == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a>{% endfor %}
  </nav>
</header>
<main id="main">
{% block content %}{% endblock %}
</main>
<footer class="foot">
  <span>Plans live in <code>data/</code>; this site is just one way to look at them.</span>
  <span class="foot-tools"><span class="textsize" role="group" aria-label="Text size">Text <button type="button" data-size="-1" aria-label="Smaller text">A−</button> <button type="button" data-size="1" aria-label="Bigger text">A+</button></span> · <button type="button" id="theme">Theme: auto</button></span>
</footer>
</div>
<script src="/assets/js/now.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
