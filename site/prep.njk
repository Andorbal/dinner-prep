---
title: Prep
section: /prep/
---
{% extends "base.njk" %}
{% block content %}
<div class="week-head"><h1>Prep-day components</h1><span class="badge b">MAKE AHEAD</span>
<p class="sub">The building blocks cooked on prep day. Dinners use them; the freezer stores the extras.</p></div>
<ul class="cards">
{% for c in model.components %}
  <li>
    <a class="t" href="/prep/{{ c.id }}/">{{ c.name }}</a>
    <p>{{ c.summary }}</p>
    <div class="meta">
      <span class="tag">makes {{ c.makes }}</span>
      <span class="tag">{{ c.time.total | mins }}</span>
      {% if c.storage.freezer_months %}<span class="tag">freezes</span>{% endif %}
    </div>
  </li>
{% endfor %}
</ul>

<h2 class="section" style="margin-top:40px">On hand</h2>
<p class="muted">Big things we've stocked up on (a share of a cow, a bulk buy), from <code>data/stock.yaml</code>. The planner tries to use these, and the grocery list takes them off.</p>
{% if model.stock.length %}
<div class="scroll-x"><table class="tbl"><thead><tr><th>Item</th><th>Had</th><th>Left after planned weeks</th><th>Where</th><th>Since</th></tr></thead><tbody>
{% for s in model.stock %}<tr><td>{{ s.name }}{% if s.note %}<br><span class="muted">{{ s.note }}</span>{% endif %}</td><td class="mono">{{ s.qty }} {{ s.unit }}</td><td class="mono">{{ s.leftQty | qty }} {{ s.shopUnit }}</td><td>{{ s.where or '' }}</td><td class="mono">{{ s.added }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p>Nothing listed yet. Add items to <code>data/stock.yaml</code>.</p>{% endif %}
{% endblock %}
