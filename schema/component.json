{
  "$id": "component.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component: something made on prep day (data/components/<id>.yaml)",
  "type": "object",
  "required": ["name", "summary", "yield", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "defs.json#/definitions/id" },
    "_file": { "type": "string" },
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "yield": {
      "type": "object",
      "required": ["qty", "unit"],
      "additionalProperties": false,
      "properties": {
        "qty": { "$ref": "defs.json#/definitions/qty" },
        "unit": { "$ref": "defs.json#/definitions/unit" },
        "one": { "type": "string", "description": "Singular noun when unit is each: 'turkey meatball'" },
        "other": { "type": "string", "description": "Plural noun when unit is each: 'turkey meatballs'" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fridge_days": { "type": "integer", "minimum": 0 },
        "freezer_months": { "type": "number", "minimum": 0, "description": "Omit if it doesn't freeze well." },
        "freeze": { "type": "string" },
        "thaw": { "type": "string" }
      }
    },
    "uses": { "type": "array", "items": { "$ref": "defs.json#/definitions/use" } },
    "ingredients": { "type": "array", "items": { "$ref": "defs.json#/definitions/line" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "minutes"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "minutes": { "type": "number", "minimum": 0 },
          "active": { "type": "boolean", "description": "true = hands busy; false = hands-off (baking, pressure cooking)" },
          "gear": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
