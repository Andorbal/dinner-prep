{
  "$id": "recipe.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe: a dinner (data/recipes/<id>.yaml)",
  "type": "object",
  "required": [
    "name",
    "summary",
    "serves",
    "spice",
    "handheld",
    "night_of_minutes",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "defs.json#/definitions/id"
    },
    "_file": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "serves": {
      "type": "integer",
      "minimum": 1
    },
    "spice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "handheld": {
      "type": "boolean",
      "description": "Can be eaten in the car."
    },
    "cuisine": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "night_of_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "min_weeks_between": {
      "type": "integer",
      "minimum": 1,
      "description": "Override household min_weeks_between_repeats."
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/definitions/use"
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/definitions/line"
      }
    },
    "sides": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/definitions/side"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "only": {
                "enum": [
                  "prepped",
                  "scratch"
                ],
                "description": "Show this step in only one view."
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "description": "Where the recipe came from (a URL or a description)."
    },
    "microwave": {
      "type": "object",
      "description": "This dinner can be packed ahead as complete microwave meals (one container per person). Fits 'microwave' nights.",
      "required": [
        "reheat"
      ],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/definitions/id"
          },
          "description": "Component, ingredient or side ids that go into each container. Anything else is packed on the side or skipped (say which in `separate`)."
        },
        "separate": {
          "type": "string",
          "description": "What's packed on the side: 'crema in a small cup, fruit in its own container'."
        },
        "reheat": {
          "type": "string"
        }
      }
    },
    "cook_night": {
      "type": "boolean",
      "description": "A more involved dinner for a night with extra time. Fits 'cook' nights."
    }
  }
}
