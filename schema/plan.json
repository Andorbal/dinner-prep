{
  "$id": "plan.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly plan (data/plans/<week_of>.yaml). week_of is the Monday.",
  "type": "object",
  "required": ["week_of", "cycle", "prep", "dinners"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "_file": { "type": "string" },
    "week_of": { "$ref": "defs.json#/definitions/date" },
    "cycle": { "enum": ["A", "B"] },
    "prep": {
      "type": "object",
      "required": ["batches"],
      "additionalProperties": false,
      "properties": {
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "times"],
            "additionalProperties": false,
            "properties": {
              "component": { "$ref": "defs.json#/definitions/id" },
              "times": { "type": "number", "exclusiveMinimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "text"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "description": "'0:00', '1:20' or a label like 'Sat night'" },
              "title": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "minutes": { "type": "integer", "description": "Estimated prep time, if you want to override the draft estimate." }
      }
    },
    "dinners": {
      "type": "object",
      "propertyNames": { "$ref": "defs.json#/definitions/day" },
      "additionalProperties": {
        "type": "object",
        "required": ["recipe"],
        "additionalProperties": false,
        "properties": {
          "recipe": { "$ref": "defs.json#/definitions/id" },
          "sides": { "type": "array", "items": { "$ref": "defs.json#/definitions/side" }, "description": "Replace the recipe's sides this week." },
          "note": { "type": "string" },
          "skipped": { "type": "boolean", "description": "We didn't end up having it." },
          "swapped_for": { "$ref": "defs.json#/definitions/id", "description": "We had this recipe instead." },
          "feedback": {
            "type": "object",
            "description": "How it went. Keys are household members (A, B, C, D) plus an optional note.",
            "properties": { "note": { "type": "string" } },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "extras": { "type": "array", "items": { "$ref": "defs.json#/definitions/line" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
